# Salin file ini jadi ".env" lalu ganti isinya sebelum deploy ke hosting.

# Port server. Kebanyakan hosting (Railway, Render, dsb) akan set ini otomatis.
PORT=3000

# WAJIB diganti — ini password untuk masuk ke /admin
ADMIN_PASSWORD=ganti_password_ini

# WAJIB diganti — string acak panjang untuk mengamankan session login
# Contoh generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=ganti_dengan_string_acak_panjang
